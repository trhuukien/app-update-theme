{% style %}
#checkout .text-hl {
  color: rgba(var(--colors-text-link))
}
#checkout .list-course > div {
  background-color: #FFFFFF;
  border-radius: 12px;
}
#checkout {
  font-size: 0.8rem;
}
#checkout div.price span > s {
  font-size: 16px;
  font-style: normal;
  line-height: 26px;
}
#checkout div.price span.price {
  font-size: 22px;
  font-style: normal;
  line-height: 40px;
  color: #0B188D;
}

@media (max-width: 768px) {
  #checkout .mobile-order-2 {
    order: 2;
  }
}

@media (min-width: 768px) {
  #checkout {
    font-size: 1rem;
  }

  #checkout div.price span > s {
    font-size: 20px;
    font-style: normal;
    line-height: 26px;
  }
  #checkout div.price span.price {
    font-size: 30px;
    font-style: normal;
    line-height: 40px;
    color: #0B188D;
  }

  #checkout .sticky {
    justify-content: space-around;
  }
}
{% endstyle %}

<div id="checkout">
  <div class="page-width">
    <div class="checkout-heading">
      <div>
        <h2 class="h2 mb-5 pt-2 pb-2 text-center">Eighteen reasons why Streaming is Awesome</h2>
      </div>
      <div class="mb-5">
        <p class="rte">
          You are minutes away from speaking {{ page.metafields.custom.language.value.name.value }} with ease and confidence.
          Your complete peace of mind is very important to us, therefore we provide you with <span class="text-hl">three guarantees</span>: a 31 day <span class="text-hl">100%-money-back</span> satisfaction guarantee, a <span class="text-hl">lifetime-access</span> guarantee and a <span class="text-hl">lowest-price-ever</span> guarantee. You have no risk at all and nothing to lose, but a lot to gain! 
        </p>
        <br>
        <p class="rte">
          All prices are listed in U.S. dollars. For all of our customers that reside outside the U.S.A. payment will automatically be in your local currency and will simply be the equivalent of the U.S. dollar price. (If you would like to see the current exchange rate between the U.S. dollar and your local currency simply google it.)
        </p>
      </div>
    </div>

    <div class="list-course grid gap-4 mb-5">
      {%- liquid
        assign group_product = page.metafields.custom.group_product.value
        assign total_price = 0
        assign main_variant = blank
        assign url_checkout_group_now = "/cart/"

        for variant in group_product
          assign product = variant.product
          if page.template_suffix == product.metafields.custom.page_template
            assign main_variant = variant
          endif
          assign total_price = total_price | plus: variant.price
          assign url_checkout_group_now = url_checkout_group_now | append: variant.id | append: ':1'
          unless forloop.last
            assign url_checkout_group_now = url_checkout_group_now | append: ','
          endunless
        endfor
      -%}

      {%- if settings.currency_code_enable -%}
        {%-assign money_price_compare_79langs = 399500 | money_with_currency -%}
        {%-assign money_price_79langs = all_products["package-deal-79-languages"].price | money_with_currency -%}

        {%-assign money_price_compare_group = 24700 | money_with_currency -%}
        {%-assign money_price_group = total_price | money_with_currency -%}

        {%-assign money_price = main_variant.price | money_with_currency -%}
      {%-else -%}
        {%-assign money_price_compare_79langs = 399500 | money -%}
        {%-assign money_price_79langs = all_products["package-deal-79-languages"].price | money -%}

        {%-assign money_price_compare_group = 24700 | money -%}
        {%-assign money_price_group = total_price | money -%}

        {%-assign money_price = main_variant.price | money -%}
      {%-endif -%}

      <div class="block-79langs p-5 md:pt-8 md:pb-8 md:pl-8 md:pr-8">
        <div class="flex gap-1.5 md:gap-4">
          <img class="h-auto self-start" src="https://cdn.shopify.com/s/files/1/0887/5707/6309/files/icon_checked.png" width="24" height="24">
          
          <div class="w-full">
            <h3 class="h3 mb-2 md:mb-4">
              The Fluent Polyglot Special Offer:
            </h3>
            <div class="content grid md:flex md:gap-4">
              <div class="md:w-3/4">
                <p>Lifetime access to the complete range of <b>all courses for 79 languages</b> is yours at an unprecedented <b>95% discount.</b></p>
                <div class="my-2 md:m-0 h-max md:w-1/4 flex justify-center items-center block md:hidden gap-2">
                  <div class="price leading-none">
                    <div class="flex gap-2 justify-center items-center md:mb-4">
                      <span>
                        <s class="price-sale font-bold">{{ money_price_compare_79langs }}</s>
                      </span>
                      <span class="price font-bold">{{ money_price_79langs }}</span>
                    </div>
                  </div>
  
                  <button
                    role="button"
                    name="add"
                    class="relative add_to_cart_button button button-solid disabled:opacity-60 disabled:cursor-not-allowed duration-200 w-max md:w-full pr-5 pl-5 md:list-layout:w-auto md:mb-2 pt-3 pb-3 md:pt-3.5 md:pb-3.5"
                  >
                    <a href="{{ "/cart/" | append: all_products["package-deal-79-languages"].variants.first.id | append: ':1' }}" class="x-atc-text">
                      <span class="flex items-center justify-center">
                        {% render 'button-label', button_label: 'BUY NOW', show_button_style: 'primary' %}
                      </span>
                    </a>
                  </button>
                </div>
                <p>We have hundreds of competitors, yet <b>no other company in the world</b> offers equivalent courses for our low price. For a rock-bottom, one-time payment of only $199 this is completely handled for life.</p>
                <p><b>You will own every course that we offer.</b> This unrivaled package deal provides truly exceptional value for money and ensures that you, your family and your friends remain fluent polyglots forever.</p>
                <p>Now is the time to get more out of life. Stop missing out. By speaking more languages, life-enhancing experiences are continuously yours. Do you agree that it makes sense to lock in the lowest price ever for award-winning courses that are empirically proven to save you time?</p>
                <p>
                  <i>This hype sale will end. We reserve the right to increase all prices at any moment.</i>
                </p>
              </div>
              <div class="md:sticky top-4 my-2 md:m-0 h-max md:w-1/4 flex justify-center items-center hidden md:block gap-2">
                <div class="price leading-none">
                  <div class="flex gap-2 justify-center items-center md:mb-4">
                    <span>
                      <s class="price-sale font-bold">{{ money_price_compare_79langs }}</s>
                    </span>
                    <span class="price font-bold">{{ money_price_79langs }}</span>
                  </div>
                </div>

                <button
                  role="button"
                  name="add"
                  class="relative add_to_cart_button button button-solid disabled:opacity-60 disabled:cursor-not-allowed duration-200 w-max md:w-full pr-5 pl-5 md:list-layout:w-auto md:mb-2 pt-3 pb-3 md:pt-3.5 md:pb-3.5"
                >
                  <a href="{{ "/cart/" | append: all_products["package-deal-79-languages"].variants.first.id | append: ':1' }}" class="x-atc-text">
                    <span class="flex items-center justify-center">
                      {% render 'button-label', button_label: 'BUY NOW', show_button_style: 'primary' %}
                    </span>
                  </a>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="block-combo-1-lang p-5 md:pt-8 md:pb-8 md:pl-8 md:pr-8">
        <div class="flex gap-1.5 md:gap-4">
          <img class="h-auto self-start" src="https://cdn.shopify.com/s/files/1/0887/5707/6309/files/icon_checked.png" width="24" height="24">
          
          <div class="w-full">
            <h3 class="h3 mb-2 md:mb-4">
              The Fluent-In-{{ page.metafields.custom.language.value.name.value }} Special Offer:
            </h3>
            
            <div class="content grid md:flex md:gap-4">
              <div class="md:w-3/4 rte mobile-order-2">
                <div class="grid gap-2 p-2 mb-2">
                  {%- for variant in group_product -%}
                    <div>
                      <div class="flex gap-2 md:gap-4 items-center">
                        <h4 class="h4" style="margin: 0"><a class="font-bold" href="/pages/learn-{{ page.metafields.custom.language.value.name.value | downcase }}-{{ variant.product.metafields.custom.page_url }}" style="color: #0B188D; --colors-text-link: 11, 24, 141;">The {{ variant.title }} {{ variant.product.title }}</a></h4>
                        {% if variant.price > 0 %}
                          <span class="price-sale h5 font-bold">{{ variant.price | money }}</span>
                        {% else %}
                          <div class="flex gap-1.5 md:gap-2">
                            <span class="price-sale h5 font-bold"><s>{{ 9800 | money }}</s></span>
                            <span class="price-sale h5 font-bold" style="color: #12BD12">FREE</span>
                          </div>
                        {% endif %}
                      </div>
                      <div class="description rte">
                        {{ variant.product.description }}
                      </div>
                    </div>
                  {%- endfor -%}
                </div>
                <p>Lifetime access to the complete range of proven, market-leading {{ page.metafields.custom.language.value.name.value }} courses is all yours for only $149.</p>
                <p>These five courses have always cost {{ money_price_compare_group }}. We are temporarily offering the Business course as a <b>free bonus</b> in the Fluent-In-{{ page.metafields.custom.language.value.name.value }} package deal.</p>
                <p>Many of the words and phrases in the Business course are also used in <b>everyday conversations</b>, therefore the course will be useful to you whether you speak {{ page.metafields.custom.language.value.name.value }} at work or not. (If you only want the {{ main_variant.product.title }} course, it can still be purchased for {{ money_price }} by clicking on the blue course link under.)</p>
                <p>Being fluent in {{ page.metafields.custom.language.value.name.value }} is a rewarding skill that continuously <b>enriches your life</b> in many beneficial ways. Join our one million satisfied customers and speak {{ page.metafields.custom.language.value.name.value }} with ease and confidence right now.</p>
              </div>
              <div class="md:sticky top-4 my-2 md:m-0 h-max md:w-1/4 flex justify-center items-center md:block gap-3">
                <div class="price leading-none">
                  <div class="flex gap-2 justify-center items-center md:mb-4">
                    <span>
                      <s class="price-sale font-bold">{{ money_price_compare_group }}</s>
                    </span>
                    <span class="price font-bold">{{ money_price_group }}</span>
                  </div>
                </div>

                <button
                  role="button"
                  name="add"
                  class="relative add_to_cart_button button button-solid disabled:opacity-60 disabled:cursor-not-allowed duration-200 w-max md:w-full pr-5 pl-5 md:list-layout:w-auto md:mb-2 pt-3 pb-3 md:pt-3.5 md:pb-3.5"
                >
                  <a href="{{ url_checkout_group_now }}" class="x-atc-text">
                    <span class="flex items-center justify-center">
                      {% render 'button-label', button_label: 'BUY NOW', show_button_style: 'primary' %}
                    </span>
                  </a>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="block-1-lang p-5 md:pt-8 md:pb-8 md:pl-8 md:pr-8">
        <div class="flex gap-1.5 md:gap-4">
          <img class="h-auto self-start" src="https://cdn.shopify.com/s/files/1/0887/5707/6309/files/icon_checked.png" width="24" height="24">
          
          <div class="w-full">
            <h3 class="h3 mb-2 md:mb-4">
              The {{ page.metafields.custom.language.value.name.value }} {{ main_variant.product.title }}:
            </h3>
            <div class="content grid md:flex md:gap-4">
              <div class="md:w-3/4 rte">
                {{ main_variant.product.description }}
              </div>
              <div class="md:sticky top-4 my-2 md:m-0 h-max md:w-1/4 flex justify-center items-center md:block gap-3">
                <div class="price leading-none">
                  <div class="flex gap-2 justify-center items-center md:mb-4">
                    <span class="price font-bold" style="color: rgba(var(--colors-price-sale));">{{ money_price }}</span>
                  </div>
                </div>

                <button
                  role="button"
                  name="add"
                  class="relative add_to_cart_button button button-solid disabled:opacity-60 disabled:cursor-not-allowed duration-200 w-max md:w-full pr-5 pl-5 md:list-layout:w-auto md:mb-2 pt-3 pb-3 md:pt-3.5 md:pb-3.5"
                >
                  <a href="{{ "/cart/" | append: main_variant.id | append: ':1' }}" class="x-atc-text">
                    <span class="flex items-center justify-center">
                      {% render 'button-label', button_label: 'BUY NOW', show_button_style: 'primary' %}
                    </span>
                  </a>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="checkout-footer text-center mt-2 rte">
      <p>Lifetime access to the complete range of proven, market-leading {{ page.metafields.custom.language.value.name.value }} language courses is all yours for <span class="price-sale">only {{ money_price_group }}.</span></p>
      <small class="price-sale">Limited Time Only. Price Will Increase Without Warning.</small>
    </div>
  </div>
</div>
