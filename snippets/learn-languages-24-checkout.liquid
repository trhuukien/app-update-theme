{% style %}
#checkout h3 {
  font-weight: 800;
  font-size: 22.5px;
  line-height: 30px;
}
a.text-hl.nav-link:not(.effect-inline) {
  color: #0B188D;
}
a.text-hl.nav-link:not(.effect-inline):after {
  border-bottom: 1px solid #0B188D;
}
#checkout button.add_to_cart_button.button-solid {
  background-color: #02B1FF;
}
#checkout .list-course > div {
  background-color: #FFFFFF;
  border-radius: 12px;
}
#checkout .list-course {
  gap: 20px;
}
#checkout div.price span > .price-sale {
  font-size: 22.5px;
  font-style: normal;
  line-height: 26px;
  font-weight: 800;
}
#checkout div.price span.price {
  font-size: 30px;
  font-style: normal;
  line-height: 40px;
  color: #1EACFA;
  font-weight: 800;
}
#checkout img.self-start {
  width: 24px;
  height: 24px;
}
#checkout .bg-price {
  background-color: #F6F6F6;
  border-radius: 12px;
  padding: 16px;
  gap: 16px;
}

.justify-space-around {
  justify-content: space-around;
}

@media (min-width: 768px) {
  #checkout h3 {
    font-size: 30px;
    line-height: 40px;
  }

  #checkout .list-course {
    gap: 30px;
  }

  #checkout div.price span > .price-sale {
    font-size: 30px;
    line-height: 40px;
  }
  #checkout div.price span.price {
    font-size: 40px;
    line-height: 48px;
  }

  #checkout img.self-start {
    width: 30px;
    height: 30px;
  }

  #checkout .bg-price {
    padding: 30px;
    gap: 26px;
  }
}

@media (max-width: 768px) {
  #checkout .mobile-order-2 {
    order: 2;
  }

  #checkout .md\:sticky {
    justify-content: space-around;
  }

  .description.rte {
    font-size: 14px;
  }
}
{% endstyle %}

{%- liquid
  assign group_product = page.metafields.custom.group_product.value
  assign count_group = 0
  assign total_price = 0
  assign main_variant = blank
  assign url_checkout_group_now = "/cart/"

  for variant in group_product
    assign count_group = count_group | plus: 1
    assign product = variant.product
    if page.template_suffix == product.metafields.custom.page_template
      assign main_variant = variant
    endif
    unless variant.product.handle == 'business-course'
      assign total_price = total_price | plus: variant.price
    endunless
    assign url_checkout_group_now = url_checkout_group_now | append: variant.id | append: ':1'
    unless forloop.last
      assign url_checkout_group_now = url_checkout_group_now | append: ','
    endunless
  endfor

  assign product79lang = all_products["package-deal-79-languages"]
  assign money_price_compare_79langs = product79lang.compare_at_price | money_without_trailing_zeros
  assign money_price_79langs = product79lang.price | money_without_trailing_zeros
  assign total_price_without_zeros = total_price | money_without_trailing_zeros
  
  if count_group == 4 or count_group == 5
    assign money_price_group = shop.metaobjects.money_data['complete-package'].money.value | money_without_trailing_zeros | default: total_price_without_zeros
  elsif count_group == 3
    assign money_price_group = shop.metaobjects.money_data['combo-3-course'].money.value | money_without_trailing_zeros | default: total_price_without_zeros
  elsif count_group == 2
    assign money_price_group = shop.metaobjects.money_data['combo-2-course'].money.value | money_without_trailing_zeros | default: total_price_without_zeros
  else
    assign money_price_group = total_price_without_zeros
  endif

  assign money_old_price_group = shop.metaobjects.money_data['complete-package-old'].money.value | money_without_trailing_zeros
  assign money_price = main_variant.price | money_without_trailing_zeros
-%}

<div id="checkout">
  <div class="page-width">
     <div class="checkout-heading">
      <div>
        <h2 class="h2 mb-5 pt-2 pb-2 text-center">Buy your language courses here</h2>
      </div>
      <div class="mb-5">
        <p class="rte">
          You are minutes away from speaking a new language with ease and confidence.
          Your complete peace of mind is very important to us, therefore we provide <a href="#our-personal-promise-to-you" class="text-hl nav-link hover-text-link leading-[initial] relative">three guarantees</a>: a 31 day <span class="text-hl font-bold">100%-money-back</span> satisfaction guarantee, a <span class="text-hl font-bold">lifetime-access</span> guarantee and a <span class="text-hl font-bold">lowest-price-ever</span> guarantee.
          You have no risk at all and nothing to lose, but a lot to gain. 
        </p>
        <br>
        <p class="rte">
          {% if count_group >= 3 %}
            Please select <span class="text-hl font-bold">one of the three</span> options depending on whether you want to be fluent in <span class="text-hl font-bold">several languages</span>, you want to be fluent in <span class="text-hl font-bold">one language</span> or you only want a <span class="text-hl font-bold">single course.</span>
          {% elsif count_group == 2 %}
            Please select <span class="text-hl font-bold">one of the three</span> options depending on whether you want to be fluent in <span class="text-hl font-bold">several languages</span>, you want to speak <span class="text-hl font-bold">one language</span> or you only want a <span class="text-hl font-bold">single course.</span>
          {% else %}
            Please select <span class="text-hl font-bold">one of the two</span> options depending on whether you want to be fluent in <span class="text-hl font-bold">several languages</span> or you only want to speak <span class="text-hl font-bold">one language.</span>
          {% endif %}
        </p>
      </div>
    </div>

    <div class="list-course grid mb-5">
      <div class="block-79langs p-5 md:pt-8 md:pb-8 md:pl-8 md:pr-8">
        <div class="flex gap-1.5 md:gap-4">
          <img class="h-auto self-start" src="https://cdn.shopify.com/s/files/1/0887/5707/6309/files/icon_checked.png" width="30" height="30">
          
          <div class="w-full">
            <h3 class="h3 mb-2 md:mb-4">
              The Fluent Polyglot Special Offer:
            </h3>
            <div class="content grid lg:flex items-center md:gap-4">
              <div class="lg:w-3/4 rte">
                <p>Lifetime access to the complete range of <b>all courses for 79 languages</b> is yours at an unprecedented <b>95% discount.</b></p>
                <div class="bg-price my-2 md:m-0 h-max flex flex-wrap justify-center items-center block md:hidden gap-2 justify-space-around">
                  <div class="price leading-none">
                    <div class="flex flex-wrap gap-3 justify-center items-center md:mb-4">
                      <span>
                        <s class="price-sale font-bold">{{ money_price_compare_79langs }}</s>
                      </span>
                      <span class="price font-bold">{{ money_price_79langs }}</span>
                    </div>
                  </div>
  
                  <button
                    role="button"
                    name="add"
                    class="relative add_to_cart_button button button-solid disabled:opacity-60 disabled:cursor-not-allowed duration-200 w-max md:w-full pr-5 pl-5 md:list-layout:w-auto md:mb-2 pt-3 pb-3 md:pt-3.5 md:pb-3.5"
                  >
                    <a href="{{ "/cart/" | append: product79lang.variants.first.id | append: ':1' }}" class="x-atc-text">
                      <span class="flex items-center justify-center text-white">
                        {% render 'button-label', button_label: 'BUY NOW', show_button_style: 'primary' %}
                      </span>
                    </a>
                  </button>
                </div>
                <p>We have hundreds of competitors, yet <b>no other company in the world</b> offers equivalent courses for our low price. For a rock-bottom, one-time payment of only {{ money_price_79langs }} this is completely handled for life.</p>
                <p><b>You will own every course that we offer.</b> This unrivaled package deal provides truly exceptional value for money and ensures that you, your family and your friends remain fluent polyglots forever.</p>
                <p>Now is the time to get more out of life. Stop missing out. By speaking more languages, life-enhancing experiences are continuously yours. Do you agree that it makes sense to lock in the lowest price ever for award-winning courses that are empirically proven to save you time?</p>
                <p>
                  <i>This hype sale will end. We reserve the right to increase all prices at any moment.</i>
                </p>
              </div>
              <div class="bg-price md:sticky top-4 my-2 md:m-0 h-max lg:w-1/4 flex flex-wrap justify-center items-center hidden md:block gap-2">
                <div class="price leading-none">
                  <div class="flex flex-wrap gap-3 justify-center items-center md:mb-4">
                    <span>
                      <s class="price-sale font-bold">{{ money_price_compare_79langs }}</s>
                    </span>
                    <span class="price font-bold">{{ money_price_79langs }}</span>
                  </div>
                </div>

                <button
                  role="button"
                  name="add"
                  class="relative add_to_cart_button button button-solid disabled:opacity-60 disabled:cursor-not-allowed duration-200 w-max md:w-full pr-5 pl-5 md:list-layout:w-auto md:mb-2 pt-3 pb-3 md:pt-3.5 md:pb-3.5"
                >
                  <a href="{{ "/cart/" | append: product79lang.variants.first.id | append: ':1' }}" class="x-atc-text">
                    <span class="flex items-center justify-center">
                      {% render 'button-label', button_label: 'BUY NOW', show_button_style: 'primary' %}
                    </span>
                  </a>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="{% if count_group == 1 %}hidden {% endif %}block-combo-1-lang p-5 md:pt-8 md:pb-8 md:pl-8 md:pr-8">
        <div class="flex gap-1.5 md:gap-4">
          <img class="h-auto self-start" src="https://cdn.shopify.com/s/files/1/0887/5707/6309/files/icon_checked.png" width="30" height="30">
          
          <div class="w-full">
            <h3 class="h3 mb-2 md:mb-4">
              {% if count_group == 2 %}I only want to speak {{ page.metafields.custom.language.value.name.value }}:{% else %}Fluency in one language:{% endif %}
            </h3>
            
            <div class="content grid lg:flex items-center md:gap-4">
              <div class="lg:w-3/4 rte mobile-order-2">
                <div class="grid gap-2 p-2 mb-2">
                  {%- for variant in group_product -%}
                    <div>
                      <div class="flex gap-2 md:gap-4 justify-between md:justify-start" style="align-items: baseline;">
                        <h4 class="h4" style="margin: 0"><a class="font-bold" target="_blank" href="/pages/learn-{{ page.metafields.custom.language.value.name.value | downcase }}-{{ variant.product.metafields.custom.page_url }}" style="color: #0B188D; --colors-text-link: 11, 24, 141;">The {{ variant.title }} {{ variant.product.title }}</a></h4>
                        {% if variant.product.handle == 'business-course' %}
                          <div class="flex gap-1.5 md:gap-2">
                            <span class="price-sale h5 font-bold"><s>{{ variant.price | money_without_trailing_zeros }}</s></span>
                            <span class="price-sale h5 font-bold" style="color: #12BD12">FREE</span>
                          </div>
                        {% else %}
                          <span class="price-sale h5 font-bold">{{ variant.price | money_without_trailing_zeros }}</span>
                        {% endif %}
                      </div>
                      <div class="description rte">
                        {{ variant.product.description }}
                      </div>
                    </div>
                  {%- endfor -%}
                </div>
                <p>
                  Lifetime access to the complete range of proven,
                  market-leading {{ page.metafields.custom.language.value.name.value }} courses is all yours for only {% if count_group == 4 or count_group == 5 %}{{ money_price_group }}{% else %}{{ total_price_without_zeros }}{% endif %}.
                </p>
                {% if count_group == 5 %}
                  <p>These five courses have always cost {{ money_old_price_group }}. We are temporarily offering the Business course as a <b>free bonus</b> in the Fluent-In-{{ page.metafields.custom.language.value.name.value }} package deal.</p>
                  <p>Many of the words and phrases in the Business course are also used in <b>everyday conversations</b>, therefore the course will be useful to you whether you speak {{ page.metafields.custom.language.value.name.value }} at work or not. (If you only want the Business course, it can still be purchased for <span data-money="business-course">$98.00</span> by clicking on the blue course link above.)</p>
                {% endif %}
                <p>{% if count_group <= 2 %}Speaking{% else %}Being fluent in{% endif %} {{ page.metafields.custom.language.value.name.value }} is a rewarding skill that continuously <b>enriches your life</b> in many beneficial ways. Join our one million satisfied customers and speak {{ page.metafields.custom.language.value.name.value }} with ease and confidence right now.</p>
              </div>
              <div class="bg-price md:sticky top-4 my-2 md:m-0 h-max lg:w-1/4 flex flex-wrap justify-center items-center md:block gap-3">
                <div class="price leading-none">
                  <div class="flex flex-wrap gap-3 justify-center items-center md:mb-4">
                    {% if count_group == 5 %}
                      <span>
                        <s class="price-sale font-bold">{{ money_old_price_group }}</s>
                      </span>
                    {% endif %}
                    <span class="price font-bold" {% unless count_group == 5 %}style="color: rgba(var(--colors-price-sale));"{% endunless %}>{{ money_price_group }}</span>
                  </div>
                </div>

                <button
                  role="button"
                  name="add"
                  class="relative add_to_cart_button button button-solid disabled:opacity-60 disabled:cursor-not-allowed duration-200 w-max md:w-full pr-5 pl-5 md:list-layout:w-auto md:mb-2 pt-3 pb-3 md:pt-3.5 md:pb-3.5"
                >
                  <a href="{{ url_checkout_group_now }}" class="x-atc-text">
                    <span class="flex items-center justify-center">
                      {% render 'button-label', button_label: 'BUY NOW', show_button_style: 'primary' %}
                    </span>
                  </a>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="block-1-lang p-5 md:pt-8 md:pb-8 md:pl-8 md:pr-8">
        <div class="flex gap-1.5 md:gap-4">
          <img class="h-auto self-start" src="https://cdn.shopify.com/s/files/1/0887/5707/6309/files/icon_checked.png" width="30" height="30">
          
          <div class="w-full">
            <div class="content grid md:flex md:justify-between md:gap-4">
              <div class="rte">
                <h3 class="h3 mb-2 md:mb-4" style="margin-top: 0;">
                  The {{ page.metafields.custom.language.value.name.value }} {{ main_variant.product.title }}:
                </h3>
                {{ main_variant.product.description }}
              </div>
              <div class="bg-price md:sticky top-4 my-2 md:m-0 h-max flex flex-wrap md:flex-nowrap justify-center items-center gap-3">
                <div class="price leading-none">
                  <div class="flex gap-2 justify-center items-center">
                    <span>
                      <span class="price-sale font-bold" style="color: rgba(var(--colors-price-sale));">{{ money_price }}</span>
                    </span>
                  </div>
                </div>

                <button
                  role="button"
                  name="add"
                  class="relative add_to_cart_button button button-solid disabled:opacity-60 disabled:cursor-not-allowed duration-200 w-max md:w-full pr-12 pl-12 md:list-layout:w-auto pt-3 pb-3 md:pt-3.5 md:pb-3.5"
                >
                  <a href="{{ "/cart/" | append: main_variant.id | append: ':1' }}" class="x-atc-text">
                    <span class="flex items-center justify-center">
                      {% render 'button-label', button_label: 'BUY NOW', show_button_style: 'primary' %}
                    </span>
                  </a>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
