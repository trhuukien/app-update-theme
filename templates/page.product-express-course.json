            "button_label": "",
            "button_link": "",
            "open_new_window": false,
            "show_button_style": "primary"
          }
        },
        "column_inicNx": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/img_-_2024-09-18T093443.026.png",
            "image_link": "",
            "open_new_window_image": false,
            "sub_title": "",
            "title": "Entering Text",
            "highlight_type": "underline",
            "heading_size": 100,
            "text": "<p>This is a very thorough method. You can type in the translation of words or commonly-used phrases. If your spelling is correct, simply move on. If not, type in the correct spelling as shown. This learning method ensures that you have spelled every word and phrase in the course correctly.</p>",
            "button_label": "",
