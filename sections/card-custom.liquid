<button id="popup-close-{{ product.id }}" class="btn-close">X</button>

<div id="popup-content-{{ product.id }}">
  <div>
    <b>{{ product.title }}</b>
  </div>
  <br>
  <div>
    <fieldset class="">
      {%- for variant in product.variants -%}
        <input
          {% unless variant.available %}
            disabled
          {% endunless %}
          type="radio"
          id="{{ variant.id }}"
          name="{{ product.id }}"
          value="{{ variant.title }}"
        >
        <label for="{{ variant.id }}">
          {% if variant.available %}
            {{ variant.title }}
          {% else %}
            <del> {{ variant.title }} </del>
          {% endif %}
        </label>
        <br>
      {%- endfor -%}
    </fieldset>
  </div>
  <br>
  <form
    method="post"
    action="/cart/add"
    id="submit-cart-{{ product.id }}"
    accept-charset="UTF-8"
    class="form"
    enctype="multipart/form-data"
    novalidate="novalidate"
    data-type="add-to-cart-form"
  >
    <input type="hidden" name="form_type" value="product">
    <input type="hidden" name="utf8" value="✓">
    <input type="hidden" name="id" value="" class="product-variant-id">
    <div class="product-form__buttons">
      <button type="submit" name="add" class="product-form__submit button button--full-width button--secondary">
        <span>Add to cart</span>
      </button>
    </div>
    <input type="hidden" name="product-id" value="{{ product.id }}">
  </form>
</div>

<script>
  document.querySelectorAll('#popup-content-{{ product.id }} input[type="radio"]').forEach(function(radio) {
    radio.addEventListener('click', function() {
        if (this.checked) {
            document.querySelector('#popup-content-{{ product.id }} .product-variant-id').value = this.id;
        }
    });
  });

  document.querySelector('#popup-close-{{ product.id }}').addEventListener('click', function() {
    this.parentElement.parentElement.classList.remove('active');
  });

  document.querySelector('#submit-cart-{{ product.id }}').addEventListener('submit', function(event) {
    event.preventDefault();

    let formData = new FormData(this); // Lấy dữ liệu từ form
    fetch('/cart/add', {
      method: 'POST',
      body: formData
    })
    .then(response => {
      alert('Success');
    })
    .catch(error => {
      alert('Error');
    });
  });
</script>
{% stylesheet %}
{% endstylesheet %}
