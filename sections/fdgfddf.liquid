{%- comment -%}
  {
    "name": "About 03",
    "author": "PusherCommerce"
    "description": "Please DO NOT copy in any form. Any act of copying will be sued and held responsible with the law"
  }
{%- endcomment -%}

{%- capture minify -%}
  <style>
    #psb-{{ section.id }} {
      --psb-gutter-x: 25px;
      background-color: {{section.settings.background_color}};
      padding-top: {{section.settings.section_padding_top}}px;
      padding-bottom: {{section.settings.section_padding_bottom}}px;
      line-height: 1.5;
    }

    #psb-{{ section.id }} .two-columns-text-inner {
      display: inline-block;
      text-align: {{section.settings.text_align}};
    }

    #psb-{{ section.id }} .two-columns-img-inner img {
      display: block;
    }

    #psb-{{ section.id }} .psb-section-title::before,
    #psb-{{ section.id }} .psb-section-title::after {
      display: none;
    }

    #psb-{{ section.id }} .psb-section-title {
      color: {{section.settings.text_color}};
      line-height: 1.2;
      margin-top: 0;
      margin-bottom: 25px;
      text-align: {{section.settings.text_align}};
    }

    #psb-{{ section.id }} .psb-divider {
      display: inline-block;
      width: 185px;
      height: 4px;
      background-color: var(--divider-color);
      margin: 0px auto 20px;
    }

    #psb-{{ section.id }} .psb-section-text p {
      color: {{section.settings.text_color}};
      margin-top: 0;
    }

    #psb-{{ section.id }} .psb-feature {
      color: {{section.settings.text_color}};
      margin-top: 0;
      margin-bottom: 15px;
      position: relative;
      padding-left: 34px;
      display: inline-block;
      width: 100%;
    }

    #psb-{{ section.id }} .psb-feature::before {
      content: '';
      width: 22px;
      height: 22px;
      border-radius: 50%;
      border: 2px solid var(--check-color);
      position: absolute;
      top: 3px;
      left: 0;
    }

    #psb-{{ section.id }} .psb-feature::after {
      content: '';
      width: 10px;
      height: 6px;
      border: 2px solid var(--check-color);
      border-top: 0;
      border-right: 0;
      transform: rotate(-45deg);
      position: absolute;
      top: 10px;
      left: 6px;
    }

    {% if section.settings.inherit_fonts == false %}
      #psb-{{ section.id }} h1.psb-section-title {
        font-size: 72px;
      }
      #psb-{{ section.id }} h2.psb-section-title {
        font-size: 56px;
      }
      #psb-{{ section.id }} h3.psb-section-title {
        font-size: 32px;
      }
      #psb-{{ section.id }} .psb-section-text p {
        font-size: 24px; margin-bottom: 24px;
      }
      #psb-{{ section.id }} .psb-feature {
        font-size: 18px;
      }
    {% endif %}

    @media only screen and (max-width: 991px) {
      #psb-{{ section.id }} .psb-section-title::before,
      #psb-{{ section.id }} .psb-section-title::after {
        display: none;
      }

      #psb-{{ section.id }} .psb-section-title {
        max-width: none;
      }
      #psb-{{ section.id }} .psb-section-text p {
        max-width: none;
      }
    }

    @media only screen and (max-width: 767px) {
      #psb-{{ section.id }} {
        min-height: auto;
        padding-top: {{section.settings.section_padding_top_mobile}}px;
        padding-bottom: {{section.settings.section_padding_bottom_mobile}}px;
      }
      #psb-{{ section.id }} .psb-divider {
        width: 120px;
      }
      {% if section.settings.inherit_fonts == false %}
        #psb-{{ section.id }} h1.psb-section-title {
          font-size: 50px;
        }
        #psb-{{ section.id }} h2.psb-section-title {
          font-size: 40px;
        }
        #psb-{{ section.id }} h3.psb-section-title {
          font-size: 26px;
        }
        #psb-{{ section.id }} .psb-section-text p {
          font-size: 20px;
        }
        #psb-{{ section.id }} .psb-feature {
          font-size: 16px;
        }
      {% endif %}
    }
  </style>
{%- endcapture -%}
{{ minify | strip_newlines }}

<div id="psb-{{ section.id }}" class="psb-{{ section.id }} psb-section psb-about-about-03" style="display: none;">
  <div class="{{ section.settings.container_width }}">
    <div class="psb-row {% if section.settings.enable_reverse %}psb-flex-row-reverse{% endif %}">
      <div class="psb-col-md-6 psb-d-flex psb-align-items-center">
        <div class="two-columns-text-inner">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'heading' %}
                {% if block.settings.heading_text != blank %}
                  <{{ block.settings.heading_tag }} class="psb-section-title" {{ block.shopify_attributes }}>
                    {{ block.settings.heading_text | escape }}
                  </{{ block.settings.heading_tag }}>
                {% endif %}
              {% when 'divider' %}
                <span class="psb-divider" style="--divider-color: {{block.settings.divider_color}}" {{ block.shopify_attributes }}></span>
              {% when 'text' %}
                {% if block.settings.section_text != blank %}
                  <div class="psb-section-text" {{ block.shopify_attributes }}>
                    {{ block.settings.section_text }}
                  </div>
                {% endif %}
              {% when 'feature' %}
                <div {{ block.shopify_attributes }}>
                  <p class="psb-feature" {{ block.shopify_attributes }} style="--check-color: {{block.settings.check_color}}">
                    {{ block.settings.about_list_item }}
                  </p>
                </div>
            {% endcase %}
          {% endfor %}
        </div>
      </div>
      <div class="psb-col-md-6">
        <div class="two-columns-img-inner">
          {% if section.settings.background_image == blank %}
            <img
              src="https://cdn.shopify.com/s/files/1/0663/5887/0235/files/grooms-prep-kit-for-wedding_1100x.jpg"
              sizes="(min-width: 1100px) 1100px, (min-width: 750px) 750px"
              loading="lazy"
              width="100%"
              height="100%"
            >
          {% else %}
            <img
              srcset="
                {%- if section.settings.background_image.width >= 750 -%}{{ section.settings.background_image | img_url: '750x' }} 750w,{%- endif -%}
                {%- if section.settings.background_image.width >= 1100 -%}{{ section.settings.background_image | img_url: '1100x' }} 1100w,{%- endif -%}
              "
              src="{{ section.settings.background_image | img_url: '750x' }}"
              alt="{{ section.settings.background_image.alt | escape }}"
              sizes="(min-width: 1100px) 1100px, (min-width: 750px) 750px"
              width="100%"
              height="100%"
              loading="lazy"
            >
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "⚡︎PSB: About 03",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "container_width",
      "options": [
        {
          "value": "psb-container",
          "label": "Container"
        },
        {
          "value": "psb-container-fluid",
          "label": "Container Fluid"
        },
        {
          "value": "psb-container-fullwidth",
          "label": "Container Fullwidth"
        }
      ],
      "default": "psb-container",
      "label": "Container width"
    },
    {
      "type": "header",
      "content": "Main settings"
    },
    {
      "type": "checkbox",
      "id": "enable_reverse",
      "default": false,
      "label": "Enable reverse layout"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "inherit_fonts",
      "default": false,
      "label": "Inherit font sizes from theme"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Font color",
      "default": "#262424"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "transparent"
    },
    {
      "type": "header",
      "content": "Section paddings"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 500,
      "step": 5,
      "unit": "px",
      "label": "Section padding-top",
      "default": 50
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 500,
      "step": 5,
      "unit": "px",
      "label": "Section padding-bottom",
      "default": 50
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "section_padding_top_mobile",
      "min": 0,
      "max": 500,
      "step": 5,
      "unit": "px",
      "label": "Section padding-top",
      "default": 50
    },
    {
      "type": "range",
      "id": "section_padding_bottom_mobile",
      "min": 0,
      "max": 500,
      "step": 5,
      "unit": "px",
      "label": "Section padding-bottom",
      "default": 50
    }
  ],
  "blocks": [
    {
      "name": "Heading",
      "type": "heading",
      "limit": 1,
      "settings": [
        {
          "type": "textarea",
          "id": "heading_text",
          "label": "Heading text",
          "default": "Heading text"
        },
        {
          "type": "select",
          "id": "heading_tag",
          "label": "Heading tag",
          "options": [
            {
              "value": "h1",
              "label": "H1"
            },
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
              "label": "H3"
            }
          ],
          "default": "h2"
        }
      ]
    },
    {
      "name": "Divider",
      "type": "divider",
      "limit": 1,
      "settings": [
        {
          "type": "color",
          "id": "divider_color",
          "label": "Divider color",
          "default": "#ff6303"
        }
      ]
    },
    {
      "name": "Text",
      "type": "text",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "section_text",
          "label": "Section text",
          "default": "<p>Section text</p>"
        }
      ]
    },
    {
      "name": "Feature",
      "type": "feature",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "about_list_item",
          "label": "Feature text",
          "default": "Feature text"
        },
        {
          "type": "color",
          "id": "check_color",
          "label": "Icon color",
          "default": "#ff6303"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "⚡︎PSB: About 03",
      "blocks": [
        {
          "type": "heading",
          "settings": {
            "heading_tag": "h3",
            "heading_text": "Special Personality"
          }
        },
        {
          "type": "text",
          "settings": {
            "section_text": "<p>More and more people are interested in personal branded products. We understand this and offer a special line of watches engraved with your name.</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "about_list_item": "100% made by renowned watchmakers."
          }
        },
        {
          "type": "feature",
          "settings": {
            "about_list_item": "Power reserve up to 48 hours."
          }
        },
        {
          "type": "feature",
          "settings": {
            "about_list_item": "Anti-scratch sapphire glass."
          }
        }
      ]
    }
  ]
}
{% endschema %}
