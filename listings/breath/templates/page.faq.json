    "faq": {
      "type": "faq",
      "blocks": {
        "block-1": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "faq",
            "another_icon": "",
            "custom_icon": "",
            "heading": "Is your product 100% pure and natural?",
            "row_content": "<p>Yes, our honey is 100% pure and natural. We do not heat or treat our honey, preserving its natural goodness and nutritional benefits.</p>"
          }
        },
        "block-2": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "faq",
            "another_icon": "",
            "custom_icon": "",
            "heading": "What pack sizes do you offer?",
            "row_content": "<p>We offer a variety of pack sizes to cater to different needs. Whether you're looking for a small jar or a bulk order, we have options available to suit your preferences.</p>"
          }
        },
        "block-3": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "faq",
            "another_icon": "",
            "custom_icon": "",
            "heading": "Can I return or exchange my purchase?",
            "row_content": "<p>Yes, we have a 30-day return policy. If you're not satisfied with your purchase, you can request a return within 30 days of receiving your item. Please refer to our refund policy for more information on how to initiate a return or exchange.</p>"
          }
        },
        "block-4": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "faq",
            "another_icon": "",
            "custom_icon": "",
            "heading": "Do you ship internationally?",
            "row_content": "<p>Yes, we offer international shipping. However, please note that shipping fees and delivery times may vary depending on the destination. We recommend checking our shipping information or contacting our customer support for more details.</p>"
          }
        },
        "3d8149f4-33c9-4d42-9b16-5b344554c85f": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "faq",
            "another_icon": "",
            "custom_icon": "",
            "heading": "How can I contact customer support?",
            "row_content": "<p>You can reach our customer support team by phone at (+1) 9876543214 or by email at breath@bsscommerce.com. We are available to assist you with any questions or concerns you may have.</p>"
          }
        }
      },
