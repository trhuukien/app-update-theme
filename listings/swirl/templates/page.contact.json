    "a9765e91-6ba9-4e99-bf5a-bd5339897652": {
      "type": "faq",
      "blocks": {
        "template--15961076990052__a9765e91-6ba9-4e99-bf5a-bd5339897652-frequently_asked_question-3": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "faq",
            "another_icon": "",
            "custom_icon": "",
            "heading": "Are your products authentic?",
            "row_content": "<p>All our products come with a hologram sticker and a unique serial number as proof of authenticity. Beware of imitation goods sold on popular shopping sites. If it seems too good to be true, it usually is.</p>"
          }
        },
        "template--15961076990052__a9765e91-6ba9-4e99-bf5a-bd5339897652-frequently_asked_question-1": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "faq",
            "another_icon": "",
            "custom_icon": "",
            "heading": "Can I return or exchange my purchase?",
            "row_content": "<p>Yes, we have a 30-day return policy. If you're not satisfied with your purchase, you can request a return within 30 days of receiving your item. Please refer to our refund policy for more information on how to initiate a return or exchange.</p>"
          }
        },
        "template--15961076990052__a9765e91-6ba9-4e99-bf5a-bd5339897652-frequently_asked_question-2": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "faq",
            "another_icon": "",
            "custom_icon": "",
            "heading": "Do you ship internationally?",
            "row_content": "<p>Yes, we offer international shipping. However, please note that shipping fees and delivery times may vary depending on the destination. We recommend checking our shipping information or contacting our customer support for more details.</p>"
          }
        },
        "template--15961076990052__a9765e91-6ba9-4e99-bf5a-bd5339897652-frequently_asked_question-4": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "faq",
            "another_icon": "",
            "custom_icon": "",
            "heading": "How can I contact customer support?",
            "row_content": "<p>You can reach our customer support team by phone at (+1) 9876543214 or by email at info@yourstore.com. We are available to assist you with any questions or concerns you may have.</p>"
          }
        },
        "194c5c97-4ee1-4e17-b72f-e0881a6778db": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "faq",
            "another_icon": "",
            "custom_icon": "",
            "heading": "Why is the painting/texture of my wooden toy uneven?",
            "row_content": "<p>All Eurus Kids wooden toy products are painstakingly hand-crafted, assembled, and painted with child-friendly non-toxic paints. Naturally, some slight unevenness and roughness can be expected. It is what makes each wooden toy piece unique.</p>"
          }
        }
      },
