    "579b9faf-460b-458f-be66-4ef389e7a2fb": {
      "type": "faq",
      "blocks": {
        "template--15966320525412__579b9faf-460b-458f-be66-4ef389e7a2fb-frequently_asked_question-1": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "none",
            "another_icon": "",
            "custom_icon": "",
            "heading": "1. Are your products authentic?",
            "row_content": "<p>All our products come with a hologram sticker and a unique serial number as proof of authenticity. Beware of imitation goods sold on popular shopping sites. If it seems too good to be true, it usually is.</p>"
          }
        },
        "template--15966320525412__579b9faf-460b-458f-be66-4ef389e7a2fb-frequently_asked_question-2": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "none",
            "another_icon": "",
            "custom_icon": "",
            "heading": "2. Can I pre-order items if they are out of stock?",
            "row_content": "<p>Yes you can. When items go out of stock, we will make it easier for you to pre-order items by creating new products that are labelled “(insert out of stock product name) – Preorder”. These products can be purchased on a preorder basis and you may take advantage of any existing limited time discounts to purchase those products.</p><p>Do note that shipping may take up to 2 months from the time of your order.</p>"
          }
        },
        "template--15966320525412__579b9faf-460b-458f-be66-4ef389e7a2fb-frequently_asked_question-3": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "none",
            "another_icon": "",
            "custom_icon": "",
            "heading": "3. What is the estimated delivery time?",
            "row_content": "<p>Orders will be processed upon receipt of payment. From the date of payment, delivery time is estimated to be within 5 working days.</p>"
          }
        },
        "template--15966320525412__579b9faf-460b-458f-be66-4ef389e7a2fb-frequently_asked_question-4": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "none",
            "another_icon": "",
            "custom_icon": "",
            "heading": "4. What is the policy for refunds and exchanges?",
            "row_content": "<ul><li>Returns accepted for 30 days</li><li>Free return shipping</li><li>No restocking fee</li><li>No final sale items</li></ul>"
          }
        },
        "782929ca-8ee4-4cdf-9009-910b7d0e61e3": {
          "type": "frequently_asked_question",
          "settings": {
            "icon": "none",
            "another_icon": "",
            "custom_icon": "",
            "heading": "5. Do you offer Pre-order?",
            "row_content": "<p>Yes, normally products will be ready to ship in 2 weeks.</p>"
          }
        }
      },
